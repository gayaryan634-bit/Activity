import java.util.Scanner;

public class Main {
    static Scanner sc = new Scanner(System.in);
    static int[][] stock = {
        {10, 5, -1},
        {20, 3, 15},
        {8, 12, 6}
    };

    public static void main(String[] args) {
        int choice;

        do {
            System.out.println("\n1. Display Stock");
            System.out.println("2. Total Stock");
            System.out.println("3. Find Low Stock");
            System.out.println("4. Restock");
            System.out.println("5. Exit");
            System.out.print("Choice: ");
            choice = sc.nextInt();

            switch (choice) {
                case 1:
                    for (int[] row : stock) {
                        for (int item : row) {
                            System.out.print(item + " ");
                        }
                        System.out.println();
                    }
                    break;

                case 2:
                    int total = 0;
                    for (int i = 0; i < stock.length; i++) {
                        for (int j = 0; j < stock[i].length; j++) {
                            if (stock[i][j] == -1)
                                continue;
                            total += stock[i][j];
                        }
                    }
                    System.out.println("Total: " + total);
                    break;

                case 3:
                    boolean found = false;
                    for (int i = 0; i < stock.length; i++) {
                        for (int j = 0; j < stock[i].length; j++) {
                            if (stock[i][j] >= 0 && stock[i][j] < 10) {
                                System.out.println("Low stock: Row "
                                    + (i + 1) + ", Column " + (j + 1));
                                found = true;
                                break;
                            }
                        }
                        if (found) break;
                    }
                    if (!found) System.out.println("No low stock.");
                    break;

                case 4:
                    restock();
                    break;

                case 5:
                    System.out.println("Goodbye!");
                    break;

                default:
                    System.out.println("Invalid choice.");
            }
        } while (choice != 5);
    }

    static void restock() {
        System.out.print("Enter row (1-3): ");
        int r = sc.nextInt();
        System.out.print("Enter column (1-3): ");
        int c = sc.nextInt();

        if (r < 1 || r > 3 || c < 1 || c > 3) {
            System.out.println("Invalid shelf.");
            return;
        }

        if (stock[r - 1][c - 1] == -1) {
            System.out.println("Damaged shelf!");
            return;
        }

        int amount = 0;
        while (amount <= 0) {
            System.out.print("Restock amount: ");
            amount = sc.nextInt();
        }

        stock[r - 1][c - 1] += amount;
        System.out.println("Restock successful!");
    }
}
