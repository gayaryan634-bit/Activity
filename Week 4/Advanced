public class Main {
    public static void main(String[] args) {

        int size = 5;

        for (int i = 1; i <= size; i++) {

            // CONTINUE: Skip printing row 3
            if (i == 3) {
                continue;
            }

            for (int j = 1; j <= size; j++) {

                // BREAK: Stop the inner loop when j reaches 4
                if (j == 4) {
                    break;
                }

                System.out.print("* ");
            }

            System.out.println();
        }
    }
}
