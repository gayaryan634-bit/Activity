public class Main {

    static class Student {
        String name;
        int[] quizzes;

        Student(String name, int[] quizzes) {
            this.name = name;
            this.quizzes = quizzes;
        }

        double average() {
            int total = 0;
            for (int score : quizzes) {
                total += score;
            }
            return (double) total / quizzes.length;
        }
    }

    public static void main(String[] args) {
        String[] names = {"Ana", "Ben", "Carlo", "Dina"};
        int[][] data = {
            {90, 85, 95, 90},
            {80, 85, 80, 85},
            {90, 85, 95, 90},
            {70, 75, 80, 85}
        };

        Student[] students = new Student[names.length];

        for (int i = 0; i < students.length; i++) {
            students[i] = new Student(names[i], data[i]);
        }

        // Own sort algorithm: bubble sort
        for (int i = 0; i < students.length - 1; i++) {
            for (int j = 0; j < students.length - 1 - i; j++) {
                if (students[j].average() < students[j + 1].average()) {
                    Student temp = students[j];
                    students[j] = students[j + 1];
                    students[j + 1] = temp;
                }
            }
        }

        System.out.println("CLASS LEADERBOARD");
        System.out.println("Rank  Name   Average");

        int rank = 1;

        for (int i = 0; i < students.length; i++) {
            if (i > 0 && students[i].average() != students[i - 1].average()) {
                rank = i + 1;
            }

            System.out.printf("%-5d %-6s %.2f%n",
                    rank, students[i].name, students[i].average());
        }

        // Own linear search: find a student's rank
        String target = "Dina";
        int foundRank = -1;
        int currentRank = 1;

        for (int i = 0; i < students.length; i++) {
            if (i > 0 && students[i].average() != students[i - 1].average()) {
                currentRank = i + 1;
            }

            if (students[i].name.equalsIgnoreCase(target)) {
                foundRank = currentRank;
                break;
            }
        }

        if (foundRank != -1) {
            System.out.println(target + "'s rank: " + foundRank);
        } else {
            System.out.println("Student not found.");
        }
    }
}
