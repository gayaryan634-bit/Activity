public class Main {
    public static void main(String[] args) {
        int balance = 100;

        balance += 50;
        System.out.println("Balance: " + balance);

        balance *= 2;
        System.out.println("Balance: " + balance);

        balance -= 30;
        System.out.println("Balance: " + balance);

        int count = 5;
        System.out.println(count++);
        System.out.println(count);

        System.out.println(++count);
        System.out.println(count);

        // count++ prints first, then increases.
        // ++count increases first, then prints.
    }
}
