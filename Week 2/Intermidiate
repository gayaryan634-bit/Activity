public class Main {
    public static void main(String[] args) {
        double average = 85;
        int absences = 2;

        boolean pass = (average >= 75 && absences <= 3)
                    || average >= 90;

        if (pass) {
            System.out.println("PASS");
        } else {
            System.out.println("FAIL");
        }

        System.out.println("Average: " + average);
        System.out.println("Absences: " + absences);
    }
}
