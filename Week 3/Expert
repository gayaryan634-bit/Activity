public class Main {
    public static void main(String[] args) {
        String username = "admin";
        int pin = 1234;
        double balance = 10000;
        double amount = 2000;
        String tier = "Gold";
        double limit = 5000;
        double feeRate = 0;
        boolean approved = false;
        String reason = "";

        if (username.equals("admin")) {
            if (pin == 1234) {
                if (balance >= 10000) {
                    tier = "Platinum";
                } else if (balance >= 5000) {
                    tier = "Gold";
                } else if (balance >= 1000) {
                    tier = "Silver";
                } else {
                    tier = "Bronze";
                }

                switch (tier) {
                    case "Bronze": limit = 1000; feeRate = 0.03; break;
                    case "Silver": limit = 3000; feeRate = 0.02; break;
                    case "Gold": limit = 5000; feeRate = 0.01; break;
                    case "Platinum": limit = 10000; feeRate = 0.005; break;
                }

                if (amount > 0) {
                    if (balance >= amount) {
                        if (amount <= limit) {
                            approved = true;
                            reason = "Transaction approved";
                        } else {
                            reason = "Daily limit exceeded";
                        }
                    } else {
                        reason = "Insufficient balance";
                    }
                } else {
                    reason = "Invalid amount";
                }

                if (approved) {
                    System.out.println("APPROVE");
                    System.out.println("Fee: " + (amount * feeRate));
                    System.out.println(reason);
                } else {
                    System.out.println("DENY");
                    System.out.println(reason);
                }
            } else {
                System.out.println("DENY: Wrong PIN");
            }
        } else {
            System.out.println("DENY: Wrong username");
        }
    }
}
